#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
work_dir="$(mktemp -d)"
server_pid=

cleanup() {
  if [ -n "$server_pid" ]; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
  rm -rf -- "$work_dir"
}
trap cleanup EXIT

port="$((41000 + RANDOM % 20000))"
printf '{"url":"http://127.0.0.1:%s","token":"test-token","scope":"upload:any"}\n' "$port" >"$work_dir/config.json"
printf '%s' 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=' | base64 --decode >"$work_dir/preview.png"

PORT="$port" bun "$repo_root/tests/fixtures/retry-server.ts" >"$work_dir/server.log" 2>&1 &
server_pid="$!"
for _ in 1 2 3 4 5; do
  if curl --fail --silent "http://127.0.0.1:$port/health" >/dev/null; then break; fi
  sleep 1
done

output="$(MEDIA_CONFIG="$work_dir/config.json" node "$repo_root/cli/media.js" upload "$work_dir/preview.png")"
[ "$output" = 'https://media.example.test/retried.png' ]

printf 'Media CLI retries transient upload saturation\n'
