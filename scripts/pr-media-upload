#!/usr/bin/env bash
set -euo pipefail

[ "$#" -eq 1 ] || { printf 'Usage: pr-media-upload <image-or-video>\n' >&2; exit 2; }

source_path="$(realpath -- "$1")"
[ -f "$source_path" ] || exit 2

file_size() {
  stat -c %s -- "$1" 2>/dev/null || stat -f %z -- "$1"
}

invalid_video() {
  printf 'Video must be a prepared 1080p H.264/AAC MP4.\n' >&2
  exit 1
}

validate_video() {
  local video_codec pixel_format dimensions width height audio_codecs codec
  video_codec="$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$source_path")" || invalid_video
  pixel_format="$(ffprobe -v error -select_streams v:0 -show_entries stream=pix_fmt -of default=noprint_wrappers=1:nokey=1 "$source_path")" || invalid_video
  dimensions="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "$source_path")" || invalid_video
  audio_codecs="$(ffprobe -v error -select_streams a -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$source_path")" || invalid_video

  width="${dimensions%x*}"
  height="${dimensions#*x}"
  [ "$video_codec" = h264 ] || invalid_video
  [ "$pixel_format" = yuv420p ] || invalid_video
  case "$width" in '' | *[!0-9]*) invalid_video ;; esac
  case "$height" in '' | *[!0-9]*) invalid_video ;; esac
  if ! { [ "$width" -le 1920 ] && [ "$height" -le 1080 ]; } &&
     ! { [ "$width" -le 1080 ] && [ "$height" -le 1920 ]; }; then
    invalid_video
  fi
  while IFS= read -r codec; do
    [ -z "$codec" ] || [ "$codec" = aac ] || invalid_video
  done <<<"$audio_codecs"
}

media_root="${PR_MEDIA_ROOT:-/srv/pr-media}"
base_url="${PR_MEDIA_BASE_URL:?Set PR_MEDIA_BASE_URL to the public media URL}"
base_url="${base_url%/}"
image_limit="${PR_MEDIA_MAX_IMAGE_BYTES:-52428800}"
video_limit="${PR_MEDIA_MAX_VIDEO_BYTES:-104857600}"
optimizer="${PR_MEDIA_OPTIMIZE_COMMAND:-pr-media-optimize}"
pruner="${PR_MEDIA_PRUNE_COMMAND:-pr-media-prune}"

extension="${source_path##*.}"
extension="$(printf '%s' "$extension" | tr '[:upper:]' '[:lower:]')"
mime_type="$(file --brief --mime-type -- "$source_path")"

case "$mime_type:$extension" in
  image/gif:gif | image/jpeg:jpg | image/jpeg:jpeg | image/png:png | image/webp:webp)
    limit="$image_limit"
    should_optimize=1
    ;;
  video/mp4:mp4)
    limit="$video_limit"
    should_optimize=0
    ;;
  *)
    printf 'Unsupported media type or mismatched extension: %s (.%s)\n' "$mime_type" "$extension" >&2
    exit 1
    ;;
esac

[ "$(file_size "$source_path")" -le "$limit" ] || { printf 'Media exceeds the upload limit.\n' >&2; exit 1; }
[ "$should_optimize" = 1 ] || validate_video

temporary=
fallback_lock=
temporary_dir="$(mktemp -d "${TMPDIR:-/tmp}/media-upload.XXXXXX")"
cleanup() {
  [ -z "$temporary" ] || rm -f -- "$temporary"
  rm -rf -- "$temporary_dir"
  [ -z "$fallback_lock" ] || rmdir -- "$fallback_lock" 2>/dev/null || true
}
trap cleanup EXIT

optimized_path="$source_path"
if [ "$should_optimize" = 1 ] && [ "${PR_MEDIA_OPTIMIZE:-1}" = 1 ]; then
  optimized_path="$("$optimizer" "$source_path" "$temporary_dir/media")"
  extension="${optimized_path##*.}"
fi
[ "$(file_size "$optimized_path")" -le "$limit" ] || { printf 'Optimized media exceeds the upload limit.\n' >&2; exit 1; }

digest="$(sha256sum -- "$optimized_path" | awk '{print $1}')"
prefix="${digest:0:2}"
destination_dir="$media_root/$prefix"
destination="$destination_dir/$digest.$extension"
url="$base_url/$prefix/$digest.$extension"

install -d -m 0755 "$media_root"
if command -v flock >/dev/null 2>&1; then
  exec 9>"$media_root/.upload.lock"
  flock 9
else
  fallback_lock="$media_root/.upload.lock.d"
  mkdir -- "$fallback_lock" || { printf 'Another media upload is in progress.\n' >&2; exit 1; }
fi

if command -v "$pruner" >/dev/null 2>&1; then
  PR_MEDIA_LOCK_HELD=1 "$pruner"
fi

if [ ! -f "$destination" ]; then
  install -d -m 0755 "$destination_dir"
  temporary="$(mktemp "$destination_dir/.upload.XXXXXX")"
  install -m 0644 -- "$optimized_path" "$temporary"
  mv -- "$temporary" "$destination"
  temporary=
fi

case "$mime_type" in
  image/*) printf '![Media](%s)\n' "$url" ;;
  *) printf '%s\n' "$url" ;;
esac
