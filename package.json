{
  "name": "sago-media-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "cli"
  ],
  "scripts": {
    "build": "bun build server.ts --target=bun --outfile=dist/server.js",
    "check": "bun run test && bun run build && npm pack --dry-run --workspace cli",
    "release": "cd cli && release-it --config ../release-it.config.cjs",
    "test": "bash tests/api && bash tests/pipeline",
    "pack:cli": "npm pack --workspace cli"
  },
  "devDependencies": {
    "release-it": "20.2.0"
  }
}
